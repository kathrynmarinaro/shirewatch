# --- secrets -----------------------------------------------------------
# Real credentials live here: DB password, the app password hash, the Gmail
# app password and the cron token. config.example.php is the tracked template.
config.php

# --- agent worktrees ---------------------------------------------------
# Claude Code creates a git worktree per parallel agent in here. They're live
# working directories with their own branches, not source — committing them
# would nest checkouts inside the repo. Only worktrees/ is ignored, so genuine
# project config under .claude/ (settings, skills) still gets tracked.
.claude/worktrees/

# --- deployment / local ------------------------------------------------
# Bundles built for uploading to Hostinger. Both are build OUTPUT — every file
# in them is a copy of something already tracked, rebuilt by
# tools/build-deploy.php whenever it's needed. Committing them would mean a
# second copy of the whole app that silently goes stale.
*.zip
shirewatch-deploy/

.DS_Store
*.log

# --- uploaded photos and documents -------------------------------------
# Everything the app stores lands under public/uploads/. These are the ONLY
# copies of your photos — the originals are kept rather than reaped
# (CLAUDE.md), so this directory IS your data, not a cache. It does not belong
# in git: a repo is not a backup, and pushing the inside of your house to a
# remote is not something you should be able to do by accident.
#
# The four sub-directories and their .gitkeep files ARE tracked, so a fresh
# checkout has somewhere to write, and so is the deny-all .htaccess — an
# untracked .htaccess is one that exists on exactly one machine, and that file
# is the only thing stopping an uploaded file from being executed.
public/uploads/*/*
!public/uploads/*/.gitkeep
!public/uploads/.htaccess
